10 WAIT 0:CLS:DIM A(99)
20 LOCATE 0,0:PRINT "CALCULATION AND ARRAY";
30 S=0
40 FOR I=0 TO 99
50 A(I)=I*I
60 NEXT I
70 FOR I=0 TO 99
80 IF A(I)<>I*I THEN 200
90 S=S+A(I)
100 NEXT I
110 LOCATE 0,1:PRINT "SUM :";S;
120 LOCATE 0,2:PRINT "EXPECTED : 328350";
130 IF S<>328350 THEN 200
140 LOCATE 0,3:PRINT "100 VALUES : OK";
150 LOCATE 0,5:PRINT "PRESS ANY KEY TO END";
160 A$=INKEY$:IF A$="" THEN 160
170 WAIT:END
200 LOCATE 0,3:PRINT "ARRAY ERROR";
210 GOTO 150
