10 WAIT 0:CLS:N=0
20 LOCATE 0,0:PRINT "PC-G850 CLAVIER";
30 LOCATE 0,5:PRINT "Q : QUITTER / BREAK";
40 A$=INKEY$:IF A$="" THEN 40
50 IF A$="Q" OR A$="q" THEN 180
60 C=ASC(A$):N=N+1
70 LOCATE 0,2:PRINT "                       ";
80 LOCATE 0,2:PRINT "TOUCHE : ";
90 IF C>=32 AND C<=126 THEN PRINT A$;
100 LOCATE 0,3:PRINT "                       ";
110 LOCATE 0,3:PRINT "CODE :";C;
120 LOCATE 0,4:PRINT "                       ";
130 LOCATE 0,4:PRINT "COMPTE :";N;
140 IF INKEY$<>"" THEN 140
150 GOTO 40
180 WAIT:END
